# Secrets
.env

# Markdown is gitignored by default, with the research artifacts allowed back in.
# The guideline and the sampling design are methodology, not working notes - their
# version history is part of the record.
*.md
!README.md
!PROJECT_PLAN.md
!annotation/*.md
!docs/*.md
!reports/research_report.md

# Video production scaffolding stays local.
reports/video/
reports/*.html

# Data — raw and interim never committed (YouTube ToS + PII)
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Labeled data: keep the final CSV, ignore scratch exports
data/labeled/*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Notebooks
.ipynb_checkpoints/

# Models / embeddings (large binaries)
*.bin
*.vec
models_cache/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
