# Keep new top-level working files private unless listed below.
/[!.]*
!/requirements.txt
!/src/
!/tests/
!/data/
!/annotation/
!/docs/
!/reports/

# Source and tests
/src/**
!/src/**/
!/src/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py

# Public technical documentation
*.md
!/.github/README.md
/annotation/*
!/annotation/guideline.md
/docs/*
!/docs/sampling_design.md

# Keep an output directory for scripts that write reports.
/reports/*
!/reports/.gitkeep

# Inputs for collection, training and reproducible evaluation
/data/*
!/data/sources.csv
!/data/videos.csv
!/data/raw/
!/data/interim/
!/data/labeled/
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/labeled/*
!/data/labeled/corpus_silver.csv
!/data/labeled/corpus_silver_train.csv
!/data/labeled/corpus_ai_review_test.csv
!/data/labeled/validation_ai_review.csv
!/data/labeled/folds_silver.json
!/data/labeled/density_word_counts.csv
!/data/labeled/predictions_sprint5_grouped_ai_review.csv
!/data/labeled/predictions_sprint5_grouped_silver_cv.csv

# Local credentials, environments and caches
.env
.env.*
!/.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.vscode/
.idea/
.DS_Store
Thumbs.db
